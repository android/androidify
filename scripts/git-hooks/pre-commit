#!/usr/bin/env bash
# Copyright 2026 Google LLC
#
# Git pre-commit hook: runs R8 keep-rule lint + `android analyze` regression gate
# whenever ProGuard/R8 rules or Gradle build files are staged.
#
# Install once per clone:
#   git config core.hooksPath scripts/git-hooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

CHANGED_R8_FILES="$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.pro' '*.gradle.kts' 'gradle/libs.versions.toml' 'gradle.properties' 'r8-baseline.json')"

if [[ -z "${CHANGED_R8_FILES}" ]]; then
  exit 0
fi

echo "==> [pre-commit] R8/build configuration changes detected:"
echo "${CHANGED_R8_FILES}" | sed 's/^/    • /'
echo ""

# If a library module's .pro file was modified, rebuild that module's release AAR (~2s)
AAR_TASKS=()
while IFS= read -r file; do
  if [[ "${file}" == *.pro && "${file}" != app/* ]]; then
    MODULE_DIR="$(dirname "${file}")"
    GRADLE_MODULE=":${MODULE_DIR//\//:}"
    AAR_TASKS+=("${GRADLE_MODULE}:bundleReleaseAar")
  fi
done <<< "${CHANGED_R8_FILES}"

if [[ ${#AAR_TASKS[@]} -gt 0 ]]; then
  echo "==> [pre-commit] Rebuilding modified module AAR(s): ${AAR_TASKS[*]}..."
  ./gradlew "${AAR_TASKS[@]}" --quiet
fi

EXTRA_FLAGS=()
if [[ "${R8_GATE_BUILD:-0}" == "1" ]]; then
  EXTRA_FLAGS+=(--build)
fi
if [[ -n "${R8_GATE_AAB:-}" ]]; then
  EXTRA_FLAGS+=(--aab "${R8_GATE_AAB}")
fi

python3 ./scripts/check_r8_regression.py \
  "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" \
  --check-staged \
  --scan-libraries
