#!/usr/bin/env bash
# Copyright 2026 Google LLC
#
# Git pre-push hook: runs `check_app_r8_score.py` and `check_library_shrinking.py`
# before pushing branches that touch ProGuard/R8 rules or Gradle build configs.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

BASE_REF="origin/main"
if ! git rev-parse --verify "${BASE_REF}" >/dev/null 2>&1; then
  BASE_REF="HEAD~1"
fi

CHANGED_R8_FILES="$(git diff --name-only "${BASE_REF}...HEAD" -- \
  '*.pro' '*.gradle.kts' 'gradle/libs.versions.toml' 'gradle.properties' 'r8-baseline.json' || true)"

if [[ -z "${CHANGED_R8_FILES}" ]]; then
  exit 0
fi

echo "==> [pre-push] R8/build changes detected relative to ${BASE_REF}:"
echo "${CHANGED_R8_FILES}" | sed 's/^/    • /'

BUILD_FLAG=()
if [[ "${R8_GATE_BUILD:-0}" == "1" ]]; then
  BUILD_FLAG=(--build)
fi

APP_EXIT=0
python3 ./scripts/check_app_r8_score.py "${BUILD_FLAG[@]+"${BUILD_FLAG[@]}"}" || APP_EXIT=$?

LIB_EXIT=0
python3 ./scripts/check_library_shrinking.py --scan-libraries || LIB_EXIT=$?

if [[ "${APP_EXIT}" -ne 0 || "${LIB_EXIT}" -ne 0 ]]; then
  exit 1
fi
